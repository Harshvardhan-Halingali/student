@model StudentAttendancePerformanceSystem.Models.RegisterViewModel
@{
    ViewData["Title"] = "Institutional Registration";
}

<div class="row justify-content-center py-3">
    <div class="col-md-7 col-lg-6">
        <div class="auth-hero-card">
            <!-- Security Header -->
            <div class="auth-header">
                <div class="auth-shield-badge">
                    <i class="bi bi-person-badge-fill"></i>
                </div>
                <h2 class="h4 fw-bold mb-1">Register Account</h2>
                <p class="text-muted small mb-0 text-white-50">Provision your secure credentials on CampusTrack</p>
            </div>

            <div class="p-4 p-md-5">
                <form method="post" asp-action="Register">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small d-flex align-items-center gap-2 border-0 shadow-sm mb-3"></div>

                    <div class="mb-3">
                        <label asp-for="FullName" class="form-label">
                            <i class="bi bi-person-fill text-muted me-1"></i> Full Name
                        </label>
                        <input asp-for="FullName" class="form-control" placeholder="e.g. Dr. Eleanor Vance" required />
                        <span asp-validation-for="FullName" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Email" class="form-label">
                            <i class="bi bi-envelope-fill text-muted me-1"></i> Institutional Email Address
                        </label>
                        <input asp-for="Email" type="email" class="form-control" placeholder="user@campus.local" required />
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Role" class="form-label">
                            <i class="bi bi-shield-check text-muted me-1"></i> Select Account Tier
                        </label>
                        <select asp-for="Role" class="form-select">
                            <option value="Teacher">Teacher (Attendance & Grading permissions)</option>
                            <option value="Student">Student (Academic Record View)</option>
                            <option value="Admin">Administrator (Full Institutional Management)</option>
                        </select>
                        <span asp-validation-for="Role" class="text-danger small"></span>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="Password" class="form-label">
                                <i class="bi bi-key-fill text-muted me-1"></i> Password
                            </label>
                            <input asp-for="Password" type="password" class="form-control" placeholder="Min. 6 chars" required />
                            <span asp-validation-for="Password" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6 mb-3">
                            <label asp-for="ConfirmPassword" class="form-label">
                                <i class="bi bi-check2-square text-muted me-1"></i> Confirm Password
                            </label>
                            <input asp-for="ConfirmPassword" type="password" class="form-control" placeholder="Re-type password" required />
                            <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                        </div>
                    </div>

                    <button type="submit" class="btn btn-primary w-100 py-2 fw-semibold mt-3 shadow-sm">
                        <i class="bi bi-shield-plus me-1"></i> Complete Registration
                    </button>
                </form>

                <hr class="my-4" />

                <div class="text-center">
                    <span class="text-muted small">Already registered with credentials? </span>
                    <a asp-action="Login" class="text-decoration-none fw-semibold small text-primary">
                        Sign In Here <i class="bi bi-arrow-right-short"></i>
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
