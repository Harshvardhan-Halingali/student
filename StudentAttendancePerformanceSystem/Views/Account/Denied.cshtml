@{
    ViewData["Title"] = "Access Denied - 403 Forbidden";
}

<div class="row justify-content-center py-5">
    <div class="col-md-6 col-lg-5 text-center">
        <div class="card border-0 shadow-sm p-4 p-md-5">
            <div class="mb-4">
                <div class="d-inline-flex p-4 rounded-circle bg-danger bg-opacity-10 text-danger fs-1 mb-3">
                    <i class="bi bi-shield-x"></i>
                </div>
                <h1 class="h3 fw-bold text-dark">Access Authorization Required</h1>
                <p class="text-muted small">
                    Your authenticated role does not possess the cryptographic authorization claims required to access this endpoint.
                </p>
            </div>

            <div class="p-3 bg-light rounded text-start small mb-4 font-monospace text-muted">
                <div><i class="bi bi-info-circle me-1"></i> Policy: Scoped Role Validation</div>
                <div><i class="bi bi-person me-1"></i> Current Identity: @User.Identity?.Name</div>
                <div><i class="bi bi-shield-lock me-1"></i> Active Role: @(User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value ?? "Unauthenticated")</div>
            </div>

            <div class="d-flex gap-2 justify-content-center">
                <a asp-controller="Home" asp-action="Index" class="btn btn-primary px-4 fw-semibold shadow-sm">
                    <i class="bi bi-arrow-left me-1"></i> Return to Dashboard
                </a>
                <a asp-controller="Account" asp-action="Login" class="btn btn-outline-secondary">
                    Switch Account
                </a>
            </div>
        </div>
    </div>
</div>
