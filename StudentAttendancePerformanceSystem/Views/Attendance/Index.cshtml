@model IEnumerable<AttendanceRecord>
@{
    ViewData["Title"] = "Attendance Registry";
}

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <div>
        <h1 class="h3 fw-bold mb-1">Attendance Log</h1>
        <p class="text-muted small mb-0">Daily presence verifications, date filtering, and roll checks.</p>
    </div>
    <a asp-action="Create" class="btn btn-primary">
        <i class="bi bi-calendar-plus-fill"></i> Record Attendance
    </a>
</div>

<!-- Date Filter Ribbon -->
<div class="card border-0 shadow-sm p-3 mb-4 bg-white">
    <form method="get" class="row g-2 align-items-center">
        <div class="col-auto">
            <label class="form-label mb-0 fw-semibold text-muted small">
                <i class="bi bi-calendar-date text-primary me-1"></i> Selected Date:
            </label>
        </div>
        <div class="col-auto">
            <input type="date" name="date" value="@ViewBag.Date" class="form-control form-control-sm" />
        </div>
        <div class="col-auto">
            <button class="btn btn-outline-primary btn-sm px-3">
                <i class="bi bi-funnel-fill"></i> Filter Date
            </button>
        </div>
    </form>
</div>

<!-- Attendance Records Table -->
<div class="card border-0 shadow-sm">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th class="ps-4">Date</th>
                        <th>Roll Number</th>
                        <th>Student Name</th>
                        <th>Status</th>
                        <th>Remarks</th>
                        <th class="text-end pe-4">Action</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="6" class="text-center py-5 text-muted">
                                <i class="bi bi-calendar-x display-6 d-block mb-2 text-muted"></i>
                                No attendance records found for this date. Click "Record Attendance" above to log entries.
                            </td>
                        </tr>
                    }
                    @foreach (var a in Model)
                    {
                        var isPresent = a.Status == "Present";
                        <tr>
                            <td class="ps-4 fw-semibold text-dark">
                                <i class="bi bi-calendar2 me-1 text-muted"></i>
                                @a.AttendanceDate.ToString("dd MMM yyyy")
                            </td>
                            <td>
                                <span class="badge bg-light text-dark border font-monospace">@a.Student?.RollNumber</span>
                            </td>
                            <td class="fw-bold">@a.Student?.FullName</td>
                            <td>
                                <span class="badge-custom @(isPresent ? "present" : "absent")">
                                    <i class="bi @(isPresent ? "bi-check-circle-fill" : "bi-x-circle-fill")"></i>
                                    @a.Status
                                </span>
                            </td>
                            <td class="text-muted small">
                                @(string.IsNullOrWhiteSpace(a.Remarks) ? "—" : a.Remarks)
                            </td>
                            <td class="text-end pe-4">
                                <form asp-action="Delete" asp-route-id="@a.Id" method="post" class="d-inline" onsubmit="return confirm('Remove this attendance entry?');">
                                    <button class="btn btn-sm btn-outline-danger" title="Delete Entry">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
