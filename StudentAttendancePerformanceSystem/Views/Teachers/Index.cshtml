@model IEnumerable<StudentAttendancePerformanceSystem.Models.AppUser>
@{
    ViewData["Title"] = "Manage Teachers";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h1 class="h3 mb-1">Teachers</h1>
        <p class="text-muted mb-0">View, edit, and manage teacher profiles and accounts.</p>
    </div>
    <a class="btn btn-primary" asp-action="Create">
        + Add Teacher
    </a>
</div>

<div class="card shadow-sm border-0">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover table-striped align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-3">Name</th>
                        <th>Email</th>
                        <th>Department</th>
                        <th>Subject</th>
                        <th>Phone</th>
                        <th class="text-end pe-3">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="6" class="text-center py-4 text-muted">No teachers found. Click "Add Teacher" above to add one.</td>
                        </tr>
                    }
                    @foreach (var t in Model)
                    {
                        <tr>
                            <td class="ps-3 fw-semibold">@t.FullName</td>
                            <td>@t.Email</td>
                            <td>@(string.IsNullOrWhiteSpace(t.Department) ? "—" : t.Department)</td>
                            <td>@(string.IsNullOrWhiteSpace(t.Subject) ? "—" : t.Subject)</td>
                            <td>@(string.IsNullOrWhiteSpace(t.Phone) ? "—" : t.Phone)</td>
                            <td class="text-end pe-3">
                                <a class="btn btn-sm btn-outline-primary me-1" asp-action="Edit" asp-route-id="@t.Id">Edit</a>
                                <form asp-action="Delete" asp-route-id="@t.Id" method="post" class="d-inline" onsubmit="return confirm('Are you sure you want to delete this teacher account?');">
                                    <button class="btn btn-sm btn-outline-danger">Delete</button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
