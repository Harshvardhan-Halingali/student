@model ExamMark
@{
    ViewData["Title"] = "Add Exam Marks";
}

<div class="row justify-content-center py-2">
    <div class="col-md-7 col-lg-6">
        <div class="card border-0 shadow-sm">
            <div class="card-body p-4 p-md-5">
                <div class="d-flex align-items-center gap-3 mb-4">
                    <div class="p-3 rounded-circle bg-warning bg-opacity-10 text-warning fs-4">
                        <i class="bi bi-award-fill"></i>
                    </div>
                    <div>
                        <h2 class="h4 fw-bold mb-1">Add Exam Marks</h2>
                        <p class="text-muted small mb-0">Record exam scores and subject performance</p>
                    </div>
                </div>

                <form method="post">
                    <div asp-validation-summary="All" class="alert alert-danger py-2 small mb-3"></div>

                    <div class="mb-3">
                        <label class="form-label">
                            <i class="bi bi-person-fill text-muted me-1"></i> Student
                        </label>
                        <select asp-for="StudentId" class="form-select" required>
                            <option value="">-- Choose student from roster --</option>
                            @foreach (Student s in ViewBag.Students)
                            {
                                <option value="@s.Id">@s.RollNumber — @s.FullName (@s.Course)</option>
                            }
                        </select>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="Subject" class="form-label">
                                <i class="bi bi-journal-bookmark text-muted me-1"></i> Subject
                            </label>
                            <input asp-for="Subject" class="form-control" placeholder="e.g. Mathematics" required />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="ExamName" class="form-label">
                                <i class="bi bi-pencil-square text-muted me-1"></i> Assessment Name
                            </label>
                            <input asp-for="ExamName" class="form-control" placeholder="e.g. Midterm 1" required />
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="MarksObtained" class="form-label">
                                <i class="bi bi-check2 text-muted me-1"></i> Marks Obtained
                            </label>
                            <input asp-for="MarksObtained" type="number" step="0.01" class="form-control" placeholder="85.5" required />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="MaximumMarks" class="form-label">
                                <i class="bi bi-slash-square text-muted me-1"></i> Maximum Marks
                            </label>
                            <input asp-for="MaximumMarks" type="number" step="0.01" class="form-control" placeholder="100" value="100" required />
                        </div>
                    </div>

                    <div class="mb-4">
                        <label asp-for="ExamDate" class="form-label">
                            <i class="bi bi-calendar-event text-muted me-1"></i> Exam Date
                        </label>
                        <input asp-for="ExamDate" type="date" class="form-control" value="@DateTime.Today.ToString("yyyy-MM-dd")" required />
                    </div>

                    <div class="d-flex gap-2">
                        <button class="btn btn-primary px-4 fw-semibold shadow-sm">
                            <i class="bi bi-check2-circle me-1"></i> Save Exam Marks
                        </button>
                        <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
