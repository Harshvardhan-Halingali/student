@{
    ViewData["Title"] = "Executive Dashboard";
    var role = User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value ?? "User";
}

<!-- Welcome & Security Overview Banner -->
<div class="card border-0 shadow-sm p-4 mb-4" style="background: linear-gradient(135deg, var(--slate-900) 0%, var(--slate-850) 100%); color: #ffffff; border-radius: var(--radius-xl);">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
        <div>
            <div class="d-flex align-items-center gap-2 mb-2">
                <span class="badge bg-success bg-opacity-25 text-success border border-success border-opacity-50 px-2 py-1 small fw-semibold">
                    <i class="bi bi-shield-fill-check me-1"></i> VERIFIED SESSION
                </span>
                <span class="text-muted small">| Logged in as <strong class="text-white">@User.Identity?.Name</strong></span>
            </div>
            <h1 class="h3 fw-bold mb-1 text-white">Academic Performance & Attendance Suite</h1>
            <p class="text-muted small mb-0">System metrics, real-time records, and authorized administrative controls.</p>
        </div>
        <div class="d-flex align-items-center gap-2">
            <span class="role-pill @role.ToLower() px-3 py-2 fs-6">
                <i class="bi bi-person-badge me-1"></i> @role ROLE
            </span>
        </div>
    </div>
</div>

<!-- Key Performance & Metric Cards -->
<div class="row g-3 mb-4">
    <!-- Students Count -->
    <div class="col-sm-6 col-lg-3">
        <div class="stat-card-custom indigo h-100">
            <div class="d-flex justify-content-between align-items-start">
                <div>
                    <div class="stat-label">Total Enrolled</div>
                    <div class="stat-value">@ViewBag.StudentCount</div>
                    <div class="small text-muted"><i class="bi bi-arrow-up-right text-indigo"></i> Active Students</div>
                </div>
                <div class="stat-icon-wrapper indigo">
                    <i class="bi bi-mortarboard-fill"></i>
                </div>
            </div>
        </div>
    </div>

    <!-- Teachers Count (Admin Only) -->
    @if (User.IsInRole("Admin"))
    {
        <div class="col-sm-6 col-lg-3">
            <div class="stat-card-custom emerald h-100">
                <div class="d-flex justify-content-between align-items-start">
                    <div>
                        <div class="stat-label">Faculty Staff</div>
                        <div class="stat-value">@ViewBag.TeacherCount</div>
                        <div class="small text-muted"><i class="bi bi-check2-circle text-success"></i> Verified Teachers</div>
                    </div>
                    <div class="stat-icon-wrapper emerald">
                        <i class="bi bi-person-workspace"></i>
                    </div>
                </div>
            </div>
        </div>
    }

    <!-- Attendance Count -->
    <div class="col-sm-6 col-lg-3">
        <div class="stat-card-custom sky h-100">
            <div class="d-flex justify-content-between align-items-start">
                <div>
                    <div class="stat-label">Attendance Logs</div>
                    <div class="stat-value">@ViewBag.AttendanceCount</div>
                    <div class="small text-muted"><i class="bi bi-clock-history text-info"></i> Recorded Sessions</div>
                </div>
                <div class="stat-icon-wrapper sky">
                    <i class="bi bi-calendar2-check-fill"></i>
                </div>
            </div>
        </div>
    </div>

    <!-- Marks Count -->
    <div class="col-sm-6 col-lg-3">
        <div class="stat-card-custom amber h-100">
            <div class="d-flex justify-content-between align-items-start">
                <div>
                    <div class="stat-label">Evaluations</div>
                    <div class="stat-value">@ViewBag.MarkCount</div>
                    <div class="small text-muted"><i class="bi bi-journal-check text-warning"></i> Graded Exams</div>
                </div>
                <div class="stat-icon-wrapper amber">
                    <i class="bi bi-award-fill"></i>
                </div>
            </div>
        </div>
    </div>

    <!-- Average Score -->
    <div class="col-sm-6 col-lg-3">
        <div class="stat-card-custom rose h-100">
            <div class="d-flex justify-content-between align-items-start">
                <div>
                    <div class="stat-label">Performance Mean</div>
                    <div class="stat-value">@(((double)ViewBag.Average).ToString("0.0"))%</div>
                    <div class="small text-muted"><i class="bi bi-graph-up-arrow text-danger"></i> Cumulative Score</div>
                </div>
                <div class="stat-icon-wrapper rose">
                    <i class="bi bi-pie-chart-fill"></i>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Launchpad & Quick Actions Panel -->
<div class="card border-0 shadow-sm p-4 mb-4">
    <div class="d-flex align-items-center justify-content-between mb-3">
        <div class="d-flex align-items-center gap-2">
            <div class="p-2 rounded bg-primary bg-opacity-10 text-primary">
                <i class="bi bi-lightning-charge-fill"></i>
            </div>
            <div>
                <h2 class="h5 fw-bold mb-0">Authorized Command Launchpad</h2>
                <small class="text-muted">Shortcuts available for your authenticated role permissions</small>
            </div>
        </div>
        <span class="badge bg-light text-secondary border">Fast Actions</span>
    </div>

    <div class="row g-3">
        @if (User.IsInRole("Admin"))
        {
            <div class="col-md-4 col-sm-6">
                <a class="quick-action-tile" asp-controller="Teachers" asp-action="Index">
                    <div class="quick-action-icon" style="background: var(--emerald-50); color: var(--emerald-600);">
                        <i class="bi bi-person-workspace"></i>
                    </div>
                    <div>
                        <div class="fw-bold">Manage Teachers</div>
                        <div class="small text-muted">View, modify & audit faculty</div>
                    </div>
                </a>
            </div>
            <div class="col-md-4 col-sm-6">
                <a class="quick-action-tile" asp-controller="Teachers" asp-action="Create">
                    <div class="quick-action-icon" style="background: var(--emerald-50); color: var(--emerald-600);">
                        <i class="bi bi-person-plus-fill"></i>
                    </div>
                    <div>
                        <div class="fw-bold">Add Teacher Account</div>
                        <div class="small text-muted">Provision new instructor access</div>
                    </div>
                </a>
            </div>
        }

        @if (User.IsInRole("Admin") || User.IsInRole("Teacher"))
        {
            <div class="col-md-4 col-sm-6">
                <a class="quick-action-tile" asp-controller="Students" asp-action="Create">
                    <div class="quick-action-icon" style="background: var(--primary-50); color: var(--primary-600);">
                        <i class="bi bi-person-fill-add"></i>
                    </div>
                    <div>
                        <div class="fw-bold">Enroll Student</div>
                        <div class="small text-muted">Register student records</div>
                    </div>
                </a>
            </div>
            <div class="col-md-4 col-sm-6">
                <a class="quick-action-tile" asp-controller="Attendance" asp-action="Create">
                    <div class="quick-action-icon" style="background: var(--sky-50); color: var(--sky-600);">
                        <i class="bi bi-calendar2-plus-fill"></i>
                    </div>
                    <div>
                        <div class="fw-bold">Record Attendance</div>
                        <div class="small text-muted">Log present & absent rosters</div>
                    </div>
                </a>
            </div>
            <div class="col-md-4 col-sm-6">
                <a class="quick-action-tile" asp-controller="Marks" asp-action="Create">
                    <div class="quick-action-icon" style="background: var(--amber-50); color: var(--amber-600);">
                        <i class="bi bi-pencil-square"></i>
                    </div>
                    <div>
                        <div class="fw-bold">Enter Exam Marks</div>
                        <div class="small text-muted">Submit assessment test results</div>
                    </div>
                </a>
            </div>
        }

        <div class="col-md-4 col-sm-6">
            <a class="quick-action-tile" asp-controller="Reports" asp-action="Index">
                <div class="quick-action-icon" style="background: var(--slate-100); color: var(--slate-700);">
                    <i class="bi bi-printer-fill"></i>
                </div>
                <div>
                    <div class="fw-bold">Audit & Reports</div>
                    <div class="small text-muted">Generate & export transcripts</div>
                </div>
            </a>
        </div>
    </div>
</div>

<!-- Security Architecture Audit Notice -->
<div class="card border-0 shadow-sm p-4" style="background: #ffffff; border-left: 4px solid var(--primary-500) !important;">
    <div class="d-flex align-items-center gap-3">
        <div class="p-3 rounded-circle bg-light text-primary fs-4">
            <i class="bi bi-shield-lock"></i>
        </div>
        <div>
            <h5 class="fw-bold mb-1">Encrypted Record Integrity</h5>
            <p class="text-muted small mb-0">
                All records, student credentials, and faculty logs are verified under authenticated claims. Changes to academic grades and attendance are committed directly to your ACID-compliant SQL Server.
            </p>
        </div>
    </div>
</div>
