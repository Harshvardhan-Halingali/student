@model IEnumerable<Student>
@{
    ViewData["Title"] = "Student Roster";
}

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <div>
        <h1 class="h3 fw-bold mb-1">Enrolled Students</h1>
        <p class="text-muted small mb-0">Active student directory, enrollment records, and academic status.</p>
    </div>
    <a class="btn btn-primary" asp-action="Create">
        <i class="bi bi-person-plus-fill"></i> Enroll New Student
    </a>
</div>

<div class="card border-0 shadow-sm">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th class="ps-4">Student</th>
                        <th>Roll Number</th>
                        <th>Course</th>
                        <th>Academic Year</th>
                        <th>Contact Email</th>
                        <th class="text-end pe-4">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="6" class="text-center py-5 text-muted">
                                <i class="bi bi-people display-6 d-block mb-2 text-muted"></i>
                                No student records found. Click "Enroll New Student" to add the first record.
                            </td>
                        </tr>
                    }
                    @foreach (var s in Model)
                    {
                        var initials = !string.IsNullOrWhiteSpace(s.FullName) 
                            ? string.Join("", s.FullName.Split(' ').Select(n => n[0])).ToUpper() 
                            : "S";
                        if (initials.Length > 2) initials = initials.Substring(0, 2);

                        <tr>
                            <td class="ps-4">
                                <div class="d-flex align-items-center gap-3">
                                    <div class="avatar-table-initial">@initials</div>
                                    <span class="fw-bold text-dark">@s.FullName</span>
                                </div>
                            </td>
                            <td>
                                <span class="badge bg-light text-dark border font-monospace px-2 py-1">@s.RollNumber</span>
                            </td>
                            <td>
                                <span class="badge bg-primary bg-opacity-10 text-primary border border-primary border-opacity-25 px-2 py-1">
                                    @(string.IsNullOrWhiteSpace(s.Course) ? "General" : s.Course)
                                </span>
                            </td>
                            <td>
                                <span class="text-muted small"><i class="bi bi-mortarboard me-1"></i>Year @s.Year</span>
                            </td>
                            <td class="text-muted small">@s.Email</td>
                            <td class="text-end pe-4">
                                <div class="d-inline-flex gap-1">
                                    <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@s.Id" title="Edit Student">
                                        <i class="bi bi-pencil"></i> Edit
                                    </a>
                                    @if (User.IsInRole("Admin"))
                                    {
                                        <form asp-action="Delete" asp-route-id="@s.Id" method="post" class="d-inline" onsubmit="return confirm('Are you sure you want to permanently delete this student record?');">
                                            <button class="btn btn-sm btn-outline-danger" title="Delete Student">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </form>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
